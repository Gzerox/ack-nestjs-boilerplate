{
    "permissions": {
        "allow": [],
        "additionalDirectories": ["/tmp"]
    },
    "enabledPlugins": {
        "superpowers@claude-plugins-official": true
    },
    "hooks": {
        "PreToolUse": [
            {
                "matcher": "Write|Edit",
